# ===== Aurel backend — PRODUCTION env template =====
# Copy to `.env.production` and fill in. Never commit the filled file.

NODE_ENV=production

# --- Core ---
# RDS Postgres connection string
DATABASE_URL=postgres://<user>:<password>@<rds-endpoint>:5432/medusa_store
# ElastiCache Redis (enables Redis event bus / cache / workflow engine in prod)
REDIS_URL=redis://<elasticache-endpoint>:6379

# Strong random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=<change-me>
COOKIE_SECRET=<change-me>
AUTH_MFA_ENCRYPTION_KEY=<change-me>

# --- CORS (your real domains) ---
STORE_CORS=https://<storefront-domain>
ADMIN_CORS=https://<backend-domain>
AUTH_CORS=https://<storefront-domain>,https://<backend-domain>

# --- S3 image storage (enables the S3 file module) ---
S3_BUCKET=<bucket-name>
S3_REGION=<aws-region>
S3_ACCESS_KEY_ID=<iam-access-key>
S3_SECRET_ACCESS_KEY=<iam-secret>
# Public base URL for stored files (bucket URL or CloudFront domain)
S3_FILE_URL=https://<bucket>.s3.<region>.amazonaws.com
# S3_ENDPOINT=            # only for S3-compatible providers (R2/MinIO)

# --- Optional: set here OR fill in admin → Store Settings (then restart) ---
# STRIPE_API_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SENDGRID_API_KEY=SG...
# EMAIL_FROM=hello@your-domain.com
# SENDGRID_ORDER_TEMPLATE=d-...
# SENDGRID_WELCOME_TEMPLATE=d-...
